# Puerto del servidor
PORT=5000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Configuracion de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=almacenamiento_db

# Seguridad y Autenticacion
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Entorno de ejecucion
NODE_ENV=development

# Configuracion de Correo Electronico (Mailtrap Sending SMTP)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=<YOUR_API_TOKEN>
EMAIL_FROM="VinCloud <no-reply@vincloud.com>"
TEST_EMAIL_RECIPIENT=tu_correo@ejemplo.com

