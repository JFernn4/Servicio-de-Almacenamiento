# Puerto del servidor
PORT=5000

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Configuracion de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=almacenamiento_db

# Seguridad y Autenticacion
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Entorno de ejecucion
NODE_ENV=development

# --- Configuracion de Correo Electronico (SMTP) ---
# OPCIÓN A (Recomendada para desarrollo): Mailtrap Sandbox (Email Testing)
# No requiere verificar dominios DNS ni envía a inboxes reales
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=tu_usuario_sandbox
# SMTP_PASS=tu_password_sandbox
# EMAIL_FROM="VinCloud <notificaciones@vincloud.com>"

# OPCIÓN B: Mailtrap Sending (Producción / Requiere dominio verificado en DNS)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=<YOUR_API_TOKEN>
EMAIL_FROM="Private Person <hello@vin.cloud.com>"

# OPCIÓN C: Gmail (Para recibir correos reales en tu cuenta sin dominio)
# Requiere generar una Contraseña de Aplicación en tu cuenta Google
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_contrasena_de_aplicacion_16_caracteres
# EMAIL_FROM="VinCloud <tu_correo@gmail.com>"

TEST_EMAIL_RECIPIENT=andresmaza2309@gmail.com

