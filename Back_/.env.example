# Puerto del servidor
PORT=5000

# Configuracion de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=almacenamiento_db

# Seguridad y Autenticacion
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Entorno de ejecucion
NODE_ENV=development

# URL del Frontend
FRONTEND_URL=http://localhost:5173

# Configuracion de Correo Electronico (MailerSend / Mailtrap / SMTP)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=<TU_API_TOKEN_O_CONTRASENA>
EMAIL_FROM="VinCloud <no-reply@tu-dominio.com>"
TEST_EMAIL_RECIPIENT=correo_de_prueba@gmail.com

