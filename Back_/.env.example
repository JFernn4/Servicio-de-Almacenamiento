# Puerto del servidor
PORT=5000

# Origen permitido para CORS (URL del frontend en local o en produccion, ej. Netlify)
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (Principio Open/Closed)
# ==============================================================================
# OPCIÓN A: EN LA NUBE (Supabase, Neon, Render, Railway, etc.)
# Si defines DATABASE_URL, el backend se conectará automáticamente a la nube con SSL.
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# DB_SSL=true

# OPCIÓN B: LOCAL (Compañeros de equipo trabajando en local)
# Si no hay DATABASE_URL, el backend usará estos parámetros automáticamente.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui
DB_NAME=almacenamiento_db

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN
# ==============================================================================
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=7d

# Entorno de ejecucion (development | production)
NODE_ENV=development

# URL del Frontend (se usa en los enlaces de verificacion y recuperacion por correo)
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# CONFIGURACIÓN DE CORREO ELECTRÓNICO (SMTP)
# ==============================================================================
# OPCIÓN A (Recomendada para desarrollo): Mailtrap Sandbox (Email Testing)
# No requiere verificar dominios DNS ni envía a inboxes reales
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=tu_usuario_sandbox
# SMTP_PASS=tu_password_sandbox
# EMAIL_FROM="VinCloud <notificaciones@vincloud.com>"

# OPCIÓN B: Mailtrap Sending (Producción / Requiere dominio verificado en DNS)
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASS=<YOUR_API_TOKEN>
EMAIL_FROM="Private Person <hello@vin.cloud.com>"

# OPCIÓN C: Brevo / Gmail (Para recibir correos reales sin dominio)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_clave_smtp_de_brevo
# EMAIL_FROM="VinCloud <tu_correo@gmail.com>"

TEST_EMAIL_RECIPIENT=andresmaza2309@gmail.com
