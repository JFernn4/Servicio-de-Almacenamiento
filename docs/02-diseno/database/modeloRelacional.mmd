%% Modelo relacional de VinCloud (fuente del diagrama modeloRelacional.png)
%% Editar este archivo y regenerar el PNG en https://mermaid.live
erDiagram
    ROL ||--o{ USUARIO : "tiene"
    USUARIO ||--o{ SUSCRIPCION : "contrata"
    PLAN ||--o{ SUSCRIPCION : "incluye"
    SUSCRIPCION ||--o{ PAGO : "genera"
    USUARIO ||--o{ PAGO : "realiza"
    USUARIO ||--o{ CARPETA : "crea"
    CARPETA |o--o{ CARPETA : "contiene"
    CARPETA |o--o{ ARCHIVO : "almacena"
    USUARIO ||--o{ ARCHIVO : "sube"

    ROL {
        int id PK
        string nombre UK
    }

    USUARIO {
        int id PK
        int rol_id FK
        string nombre
        string correo UK
        string contrasena_hash
        date fecha_registro
        boolean correo_verificado
        string nivel_acceso
        long espacio_consumido
        long espacio_disponible
    }

    PLAN {
        int id PK
        string nombre UK
        string descripcion
        decimal precio
        long capacidad_almacenamiento
        int vigencia_dias
        boolean activo "nuevo"
    }

    SUSCRIPCION {
        int id PK
        int usuario_id FK
        int plan_id FK
        date fecha_inicio
        date fecha_renovacion
        string estado "pendiente | activa | vencida | cancelada"
    }

    PAGO {
        int id PK
        int usuario_id FK
        int suscripcion_id FK
        decimal monto
        timestamp fecha "antes date"
        string estado "pendiente | aprobado | rechazado"
        string tipo "nuevo: contratacion | renovacion"
        string referencia UK "nuevo, nullable"
        string tarjeta_ultimos4 "nuevo, nullable"
    }

    CARPETA {
        int id PK
        int usuario_id FK
        int carpeta_padre_id FK "nullable"
        string nombre
        date fecha_creacion
    }

    ARCHIVO {
        int id PK
        int usuario_id FK
        int carpeta_id FK "nullable"
        string nombre
        long tamano
        string tipo
        date fecha_subida
    }
